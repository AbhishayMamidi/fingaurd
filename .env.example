# ==============================================================================
# FinGuard Microservices Platform - Environment Configuration Template
# Copy this file to .env before starting services: cp .env.example .env
# NOTE: Never commit .env or actual production credentials to source control.
# ==============================================================================

# Database Settings (PostgreSQL)
POSTGRES_USER=finguard_admin
POSTGRES_PASSWORD=change_this_postgres_password_locally
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_AUTH_DB=finguard_auth
POSTGRES_TRANSACTIONS_DB=finguard_transactions
POSTGRES_BUDGETS_DB=finguard_budgets

# Message Broker Settings (RabbitMQ)
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# Security & Authentication
JWT_SECRET=replace_with_a_secure_random_secret_key_at_least_32_characters_long
JWT_EXPIRES_IN=24h

# Port Configuration
GATEWAY_PORT=8080
FRONTEND_PORT=3000
AUTH_PORT=5001
TRANSACTION_PORT=5002
CATEGORIZATION_PORT=5003
FRAUD_PORT=5004
BUDGET_PORT=5005

# Internal Service URLs (used inside Docker network)
AUTH_SERVICE_URL=http://auth-service:5001
TRANSACTION_SERVICE_URL=http://transaction-service:5002
CATEGORIZATION_SERVICE_URL=http://categorization-service:5003
FRAUD_SERVICE_URL=http://fraud-detection-service:5004
BUDGET_SERVICE_URL=http://budget-alert-service:5005

# Environment Mode
NODE_ENV=development
ENVIRONMENT=local
LOG_LEVEL=info
